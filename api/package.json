{
  "name": "edtech-api",
  "version": "1.0.0",
  "description": "EdTech competition backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma": "prisma",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "seed": "ts-node --transpile-only src/seed.ts",
    "test:e2e": "ts-node --transpile-only tests/test-e2e.ts",
    "test:verify": "ts-node --transpile-only tests/test-brutal-verification.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.30",
    "prisma": "^5.10.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
